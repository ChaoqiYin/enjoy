{
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "desktop": "tauri dev",
    "tauri": "tauri",
    "format": "prettier --write frontend/src shared/locales frontend/vite.config.ts frontend/vitest.config.ts",
    "check": "node scripts/check-source.mjs && node scripts/check-translations.mjs && node scripts/check-version.mjs && prettier --check frontend/src shared/locales frontend/vite.config.ts frontend/vitest.config.ts",
    "test": "vitest run --config frontend/vitest.config.ts",
    "dev:ensure": "node scripts/dev-server.mjs",
    "dev:stop": "node scripts/dev-server.mjs --stop"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-virtual": "^3.14.11",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.0.0",
    "react-router": "^7.8.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "daisyui": "^5.0.50",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  },
  "name": "enjoy",
  "version": "0.1.8",
  "private": true,
  "type": "module"
}
